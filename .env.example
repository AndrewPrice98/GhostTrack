# GhostTrack configuration. Copy to backend/.env for local use (that file is git-ignored) or set
# these as environment variables on the host. Real environment variables always win.
# Names and safe defaults only: never commit real values.

# --- Admin login (optional). Without a password hash nobody can sign in; with demo/guest on,
# --- visitors browse read-only. Generate the values with: python -m ghosttrack create-admin
GHOSTTRACK_ADMIN_USER=admin
GHOSTTRACK_ADMIN_PASSWORD_HASH=
GHOSTTRACK_SECRET_KEY=
GHOSTTRACK_SESSION_HOURS=8
GHOSTTRACK_COOKIE_SECURE=true

# --- Mode
GHOSTTRACK_DEMO=false
# GHOSTTRACK_GUEST=true
# GHOSTTRACK_LIVE=true
GHOSTTRACK_LIVE_INTERVAL_S=10

# --- Storage, uploads, proxy (lines starting with # are optional; leave unset for the default)
# GHOSTTRACK_DB=/path/to/ghosttrack.db
GHOSTTRACK_MAX_UPLOAD_MB=10
GHOSTTRACK_TRUST_PROXY=false

# Rarely needed: compute the API fixture on the fly when the committed one is stale (development only).
GHOSTTRACK_COMPUTE_FIXTURES=false
